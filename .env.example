# Copy this file to .env and fill in your own keys. Never commit .env.

PORT=3000

# Meshy Text to 3D (https://www.meshy.ai/settings/api). Needs a paid plan with credits.
MESHY_API_KEY=
# Max new Meshy generations per hour per visitor (protects your credits)
MESHY_MAX_PER_HOUR=10

# Optional: Claude for the design chat and listing copy (https://console.anthropic.com).
# Leave blank to use the built-in designer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_MAX_PER_HOUR=120

# Where saved projects are stored (default: ./data)
# DATA_DIR=./data
